# NOTE: this repo is the GitHub Pages publish target — the compiled bundles in
# assets/ and the TTFs in fonts/ ARE the deliverable and must stay tracked.
# Do not add build-output rules (dist/, build/, *.min.js) here.

# Dependencies
node_modules/
.pnp
.pnp.js
jspm_packages/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment / secrets
.env
.env.*
!.env.example
*.pem
*.key

# Caches
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo
.npm/
.temp/
tmp/

# Editors
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Claude Code — local overrides stay personal; .claude/settings.json is shared
.claude/settings.local.json

# OS cruft
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

.claude/
# Patch backups of the shipped bundle (git history is the real rollback,
# and anything committed here is served publicly by GitHub Pages)
*.orig
